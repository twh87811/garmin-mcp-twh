{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garmin-mcp-twh",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Your GitHub username. Only this account can sign in and connect Claude.
    "ALLOWED_GITHUB_LOGIN": "Twh87811",
    // This Worker's public address, no trailing slash, e.g. https://garmin-mcp.<your-subdomain>.workers.dev
    "PUBLIC_URL": "https://garmin-mcp.twh87811.workers.dev"
  },
  "kv_namespaces": [
    // No id needed: Wrangler and the Deploy button create the namespace on first deploy.
    { "binding": "OAUTH_KV","id": "3ebb92bd7ece4cfeadf6b90025231610" }
  ]
  // Secrets (set in the dashboard or with `npx wrangler secret put NAME`; never commit them):
  //   GARMIN_API_KEY        – Garmin Connect personal API key
  //   GITHUB_CLIENT_ID      – GitHub OAuth app client ID
  //   GITHUB_CLIENT_SECRET  – GitHub OAuth app client secret
}
